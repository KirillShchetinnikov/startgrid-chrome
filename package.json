{
  "name": "startgrid-chrome",
  "version": "2.5.0",
  "description": "StartGrid visual bookmarks for Chrome",
  "scripts": {
    "lint:es": "eslint \"src/js/**/*.js\"",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:html": "htmlhint src/*.html",
    "lint": "npm run lint:es && npm run lint:css && npm run lint:html",
    "dev": "webpack --mode=development --watch",
    "build": "webpack --mode=production",
    "zip": "cd extension_chrome && bestzip ../startgrid-chrome.zip *",
    "release": "npm run build && npm run zip",
    "locales": "node autocompleteLocales.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KirillShchetinnikov/startgrid-chrome.git"
  },
  "browserslist": [
    "chrome >= 105"
  ],
  "author": "KirillShchetinnikov",
  "license": "ISC",
  "homepage": "https://github.com/KirillShchetinnikov/startgrid-chrome#readme",
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-dynamic-import": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "bestzip": "^4.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "htmlhint": "^1.9.2",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-csso": "^6.0.1",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-nesting": "^14.0.3",
    "postcss-sort-media-queries": "^6.7.1",
    "puppeteer": "^25.16.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svg-spritemap-webpack-plugin": "^5.1.5",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "glory-modal": "^2.3.4",
    "idb": "^8.0.4"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}

{
  "extends": "stylelint-config-standard",
  "plugins": ["@stylistic/stylelint-plugin"],
  "rules": {
    "import-notation": "string",
    "@stylistic/indentation": 2,
    "@stylistic/string-quotes": "double",
    "no-duplicate-selectors": true,
    "no-descending-specificity": null,
    "@stylistic/function-comma-space-before": "never",
    "@stylistic/function-comma-space-after": "always-single-line",
    "comment-empty-line-before": ["always", {
      "except": ["first-nested"]
    }],
    "@stylistic/color-hex-case": "lower",
    "color-hex-length": "short",
    "selector-class-pattern": "^(?:(?:o|c|u|t|s|is|has|_|js|qa)-)?[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*(?:__[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*)?(?:--[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*)?(?:\\[.+\\])?$",
    "selector-no-qualifying-type": [true, {
      "ignore": ["attribute", "class", "id"]
    }],
    "selector-max-id": 0,
    "@stylistic/selector-combinator-space-after": "always",
    "selector-attribute-quotes": "always",
    "@stylistic/declaration-block-trailing-semicolon": "always",
    "@stylistic/declaration-colon-space-before": "never",
    "@stylistic/declaration-colon-space-after": "always-single-line",
    "@stylistic/declaration-colon-newline-after": "always-multi-line",
    "property-no-vendor-prefix": true,
    "value-no-vendor-prefix": true,
    "@stylistic/number-leading-zero": "always",
    "at-rule-no-vendor-prefix": true,
    "rule-empty-line-before": null,
    "selector-pseudo-element-colon-notation": "double",
    "selector-pseudo-element-no-unknown": [true, {
      "ignorePseudoElements": ["picker", "picker-icon", "checkmark", "view-transition-old", "view-transition-new"]
    }],
    "selector-pseudo-class-no-unknown": [true, {
      "ignorePseudoClasses": ["open"]
    }],
    "selector-type-no-unknown": [true, {
      "ignoreTypes": ["selectedcontent"]
    }],
    "property-no-unknown": [true, {
      "ignoreProperties": ["field-sizing"]
    }],
    "@stylistic/selector-pseudo-class-parentheses-space-inside": "never",
    "selector-no-vendor-prefix": true,
    "@stylistic/media-feature-colon-space-after": "always",
    "@stylistic/max-line-length": 180,
    "color-function-alias-notation": null,
    "media-feature-range-notation": "prefix",
    "declaration-block-no-redundant-longhand-properties": [true, {
      "ignoreShorthands": ["inset", "gap", "overflow"]
    }],
    "property-no-deprecated": [true, {
      "ignoreProperties": ["clip", "word-wrap"]
    }]
  }
}
